# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key
JWT_EXPIRES_IN=7d

# Google OAuth2 (Admin and Customer Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend Client URL (for CORS and OAuth redirect)
CLIENT_URL=http://localhost:3000

# File Uploads (Optional: Cloudinary - falls back to local uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Auto-Triage (Google Gemini or OpenAI)
# Provide at least one API key if AI triage is enabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Alternative: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MODEL=gemini-1.5-flash

# Email Notifications (Optional: Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@helpdesk.com

# Initial Admin User Seeding
ADMIN_EMAIL=admin@helpdesk.com
ADMIN_PASSWORD=AdminSecurePassword123!
